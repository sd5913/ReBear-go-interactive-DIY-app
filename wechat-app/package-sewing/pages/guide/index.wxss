page{background:#fffbf3;color:#50372b;font-family:'Noto Sans SC','Microsoft YaHei',sans-serif}
.sewing-page{min-height:100vh;padding:0 38.46rpx calc(210rpx + env(safe-area-inset-bottom));background:#fffbf3}
.sewing-header{display:flex;align-items:center;height:92rpx;border-bottom:2rpx solid #ede2d3}
.back-button{font-size:58rpx;font-weight:400;padding:0;background:transparent;margin:0 36rpx 0 0;line-height:1;width:36rpx}
.header-title{font-size:32.7rpx;font-weight:700;flex:1}
.brand{font-size:28.8rpx;font-weight:700;padding-right:12rpx}.brand-icon{font-size:31rpx}
.guide-intro{padding:27rpx 4rpx 0}
.eyebrow{font-size:17.3rpx;color:#967e6b;font-weight:500}
.guide-heading{font-size:40.4rpx;font-weight:700;line-height:1.4;margin-top:12rpx}
.guide-subtitle{font-size:21.15rpx;color:#967e6b;line-height:1.5;margin-top:9rpx}
.progress-row{position:relative;margin-top:28rpx;height:23rpx;display:flex;align-items:center}
.progress-track{width:100%;height:9.6rpx;border-radius:6rpx;background:#efe5d8;overflow:hidden}
.progress-fill{height:100%;background:#b98b69;border-radius:6rpx}
.progress-count{position:absolute;right:0;top:-18rpx;background:#f6e0b2;border-radius:25rpx;font-size:21.15rpx;width:115rpx;line-height:50rpx;text-align:center}
.stage-nav{display:flex;justify-content:center;gap:10rpx;font-size:19.23rpx;color:#967e6b;margin-top:8rpx;margin-bottom:22rpx}
.step-card{background:#fffdf8;border:2rpx solid #eadcc8;border-radius:34.6rpx;padding:25rpx;margin-top:24rpx}
.step-tag{display:inline-block;font-size:21.15rpx;line-height:44rpx;padding:0 23rpx;background:#f6e0b2;border-radius:25rpx;font-weight:500}
.step-title{font-size:30.77rpx;line-height:1.4;font-weight:700;margin-top:18rpx}
.step-description{font-size:21.15rpx;line-height:1.5;color:#967e6b;margin-top:9rpx;min-height:26rpx}
.step-image-box{height:350rpx;width:100%;border-radius:27rpx;overflow:hidden;margin-top:19rpx;background:#ddd}
.step-image{width:100%;height:100%;display:block;mix-blend-mode:darken}
.pattern-image{width:89.57%;margin:auto}
.fabric-card{display:flex;gap:27rpx;background:#fffdf8;border:2rpx solid #eadcc8;border-radius:34.6rpx;padding:34rpx 25rpx;margin-top:36rpx;min-height:252rpx}
.fabric-image{width:196rpx;height:184.6rpx;border-radius:27rpx;flex-shrink:0}
.fabric-info{flex:1;min-width:0;display:flex;flex-direction:column;align-items:flex-start}
.fabric-name{font-size:30.77rpx;font-weight:700;line-height:1.4;margin-top:5rpx}
.fabric-size{font-size:21.15rpx;color:#967e6b;margin-top:9rpx}
.view-fabric{align-self:flex-end;margin:auto 7rpx -3rpx 0;background:#dae9ed;border-radius:25rpx;width:127rpx;line-height:44rpx;padding:0;font-size:21.15rpx}
.step-footer{position:fixed;bottom:0;left:0;right:0;z-index:5;display:flex;gap:23rpx;padding:35rpx 38.46rpx calc(36rpx + env(safe-area-inset-bottom));background:#fffbf3;border-top:2rpx solid #eadcc8}
.step-footer button{margin:0;min-width:0;line-height:1.4;min-height:92rpx;border-radius:30.77rpx;font-weight:500;display:flex;align-items:center;justify-content:center;white-space:normal}
.previous{flex:150;background:#f6e0b2;font-size:27rpx;padding:20rpx 10rpx}.next{flex:188;background:#50372b;color:#fffdf8;font-size:25rpx;padding:20rpx 12rpx}
.material-mask{position:fixed;left:0;right:0;top:0;bottom:0;z-index:30;background:rgba(77,52,41,.39);display:flex;align-items:center;padding:38.46rpx}
.material-dialog{width:100%;padding:29rpx;border:2rpx solid #eadcc8;border-radius:34.6rpx;background:#fffdf8}
.modal-heading{display:flex;align-items:center;justify-content:space-between;font-size:30.77rpx;font-weight:700;margin:9rpx 0 27rpx}
.close-button{margin:0;padding:8rpx 6rpx 8rpx 20rpx;background:transparent;line-height:1;display:flex;align-items:center}
.modal-preview{border-radius:27rpx;background:#ddd;overflow:hidden}
.selected-fabric{font-size:22rpx;color:#967e6b;line-height:1.6;margin-top:16rpx}
.missing{padding-top:40rpx;line-height:1.7}.missing button{margin-top:30rpx;background:#dae9ed}

.sewing-header .back-button{width:36rpx!important;min-width:0;flex:0 0 36rpx;margin:0 36rpx 0 0!important}
.fabric-info .view-fabric{width:127rpx!important;min-width:0;flex:0 0 44rpx;margin:auto 0 -3rpx auto!important}
.modal-heading .close-button{width:44rpx!important;min-width:0;flex:0 0 44rpx;margin:0!important}
.step-image-box.pattern-box{background:#fffdf8}
