@import '../design-ui.wxss';
.model-intro{display:flex;align-items:center;gap:12rpx;min-height:152rpx;margin:10rpx 0 22rpx;padding:0 4rpx 0 0}
.model-dialog{position:relative;box-sizing:border-box;display:flex;flex:1;min-height:94rpx;align-items:center;padding:20rpx 24rpx;border:2rpx solid #e7c99f;border-radius:24rpx;background:#fff7e7;box-shadow:0 4rpx 12rpx rgba(105,72,45,.08);color:#654637;font-size:28rpx;font-weight:600;line-height:1.45}
.model-dialog-tail{position:absolute;top:50%;right:-10rpx;width:18rpx;height:18rpx;box-sizing:border-box;transform:translateY(-50%) rotate(45deg);border-top:2rpx solid #e7c99f;border-right:2rpx solid #e7c99f;background:#fff7e7}
.model-avatar{position:relative;box-sizing:border-box;flex:0 0 128rpx;width:128rpx;height:128rpx;overflow:hidden;border:2rpx solid #e7c99f;border-radius:50%;background:#f8e7c1;box-shadow:0 4rpx 12rpx rgba(105,72,45,.12)}
.model-avatar-image{position:absolute;left:-62rpx;top:-24rpx;width:268rpx;height:211rpx;max-width:none}
.design-page.with-nav.model-page{padding-bottom:calc(260rpx + env(safe-area-inset-bottom))}
.model-list{display:flex;flex-direction:column;gap:24rpx;margin-top:0}.model-card{display:flex;align-items:center;gap:24rpx;padding:24rpx;border-radius:24rpx;outline:none;min-height:190rpx}.model-thumb{width:160rpx;height:150rpx;flex-shrink:0;background:#f4ead6;border-radius:16rpx}.model-info{flex:1;min-width:0}.model-name{font-size:30rpx;font-weight:600}.selected-model{border-color:#4d3429;box-shadow:0 0 0 2rpx #4d3429}.model-radio{width:40rpx;height:40rpx;line-height:36rpx;text-align:center;border:2rpx solid #c7ac8e;border-radius:50%;font-size:25rpx;flex-shrink:0}.model-radio.checked{background:#4d3429;color:#fffbf2;border-color:#4d3429}.model-selected{margin-top:12rpx;color:#795540;font-size:22rpx}
.model-action-bar{position:fixed;z-index:9;right:0;bottom:calc(120rpx + env(safe-area-inset-bottom));left:0;box-sizing:border-box;padding:20rpx 38rpx;border-top:1rpx solid #eadbc6;background:#fffbf2;box-shadow:0 -8rpx 22rpx rgba(77,52,41,.08)}
.model-action-bar button.start-design{display:block;width:100%;min-height:100rpx;margin:0;padding:26rpx 18rpx;border-radius:28rpx;box-shadow:0 6rpx 0 #dcc8b4;font-size:30rpx;font-weight:700;line-height:1.5}
