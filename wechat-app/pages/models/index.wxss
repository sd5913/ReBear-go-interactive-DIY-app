@import '../design-ui.wxss';
.model-list{display:flex;flex-direction:column;gap:24rpx;margin-top:48rpx}.model-card{display:flex;align-items:center;gap:24rpx;padding:24rpx;border-radius:24rpx;outline:none;min-height:190rpx}.model-thumb{width:160rpx;height:150rpx;flex-shrink:0;background:#f4ead6;border-radius:16rpx}.model-info{flex:1;min-width:0}.model-name{font-size:30rpx;font-weight:600}.selected-model{border-color:#4d3429;box-shadow:0 0 0 2rpx #4d3429}.model-radio{width:40rpx;height:40rpx;line-height:36rpx;text-align:center;border:2rpx solid #c7ac8e;border-radius:50%;font-size:25rpx;flex-shrink:0}.model-radio.checked{background:#4d3429;color:#fffbf2;border-color:#4d3429}.model-selected{margin-top:12rpx;color:#795540;font-size:22rpx}.model-page .start-design{margin-top:100rpx}
