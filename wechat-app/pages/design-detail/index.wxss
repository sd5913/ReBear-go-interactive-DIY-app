@import '../design-ui.wxss';
.design-detail-page{padding-bottom:calc(190rpx + env(safe-area-inset-bottom))}
.section-heading{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:600;margin-top:36rpx;line-height:1.7}.section-heading text{font-size:22rpx;font-weight:400;color:#88715c}.material{display:flex;gap:22rpx;padding:26rpx 0;border-bottom:1rpx dashed #c7ac8e;align-items:center}.material image{width:112rpx;height:112rpx;flex-shrink:0;border-radius:16rpx;border:1rpx solid #c7ac8e}.material-name{font-size:26rpx;font-weight:600}
.detail-guide-footer{position:fixed;z-index:20;right:0;bottom:0;left:0;box-sizing:border-box;padding:18rpx 38rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eadbc6;background:#fffbf2;box-shadow:0 -8rpx 22rpx rgba(77,52,41,.08)}
.detail-guide-footer button.guide-button{display:block;width:100%;max-width:none;margin:0;padding:34rpx 22rpx;border-radius:24rpx;font-size:31rpx;font-weight:600;line-height:1.5;box-shadow:0 5rpx 0 #dcc8b4}
