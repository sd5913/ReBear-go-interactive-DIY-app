<view class="design-page design-detail-page">
  <block wx:if="{{record}}">
    <view class="page-heading">{{record.name}}</view><view class="muted">{{modelName}} · {{t.savedOn}}{{date}}</view>
    <view class="design-preview"><rebear-preview model-id="{{modelId}}" fabrics="{{record.fabrics}}" assignments="{{assignments}}" language="{{language}}" read-only="{{true}}" hide-view-controls="{{true}}" fill-frame="{{true}}" height-rpx="{{520}}"/></view>
    <view class="section-heading"><view>{{t.usedFabrics}}</view><text>{{materials.length}}{{t.fabricUnit}}</text></view>
    <view wx:for="{{materials}}" wx:key="id" class="material"><image src="{{item.image}}" mode="aspectFill"/><view><view class="material-name">{{item.displayName}}</view><view class="muted">{{item.width}} × {{item.height}} cm · {{item.parts}}</view></view></view>
  </block>
  <block wx:else><view class="muted">{{error}}</view><button class="action primary" bindtap="back">{{t.back}}</button></block>
</view>
<view wx:if="{{record}}" class="detail-guide-footer">
  <button class="action primary guide-button" bindtap="guide">{{t.guide}}</button>
</view>
