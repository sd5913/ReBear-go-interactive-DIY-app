.design-page{min-height:100vh;padding:36rpx 38rpx 56rpx;background:repeating-linear-gradient(90deg,#fbf1dc 0 18rpx,#fffbf2 18rpx 50rpx)}.design-page.with-nav{padding-bottom:calc(170rpx + env(safe-area-inset-bottom))}.page-heading{font-family:'KaiTi','STKaiti',serif;font-size:43rpx;font-weight:700;line-height:1.5;margin:0}.muted{color:#88715c;font-size:23rpx;line-height:1.7;margin-top:12rpx}.design-page button.action,.dialog button.action{display:block;width:100%;margin:22rpx 0 0;border-radius:24rpx;padding:23rpx 18rpx;font-size:26rpx;font-weight:400;line-height:1.5;white-space:normal}.primary{background:#4d3429;color:#fffbf2}.secondary{background:#dae9ed;color:#4d3429}.plain{background:transparent;color:#88715c}.heading-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.heading-row button{margin:0;background:transparent;padding:18rpx 0 18rpx 20rpx;font-size:25rpx;line-height:1.5}.dialog-mask{position:fixed;inset:0;z-index:100;background:#40271c66;display:flex;align-items:center;justify-content:center;padding:40rpx}.dialog{width:100%;max-width:640rpx;padding:40rpx;background:#fffbf2;border:1rpx solid #c7ac8e;border-radius:28rpx}.dialog-title{font-size:34rpx;font-weight:700;line-height:1.5}.dialog label{display:block;margin:26rpx 0 12rpx;color:#88715c;font-size:23rpx}.dialog input{box-sizing:border-box;height:84rpx;width:100%;border:1rpx solid #c7ac8e;background:#fffefa;border-radius:16rpx;padding:0 18rpx;color:#4d3429;font-size:27rpx}.dialog .error{color:#8e3f31;font-size:23rpx;line-height:1.6;margin-top:16rpx}.design-preview{margin-top:28rpx}.empty-state{padding:70rpx 28rpx;text-align:center;margin-top:32rpx}.empty-state rb-bear{margin:0 auto 35rpx}.empty-state .action{max-width:400rpx!important;margin-left:auto!important;margin-right:auto!important}
