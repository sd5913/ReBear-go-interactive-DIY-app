@import '../design-ui.wxss';
@import '../../components/cushion-art.wxss';
.design-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx;margin-top:32rpx}.scheme-card{min-width:0;position:relative;overflow:hidden;border-radius:24rpx;outline:none}.scheme-art{height:270rpx;background:#f4ead6;display:flex;justify-content:center;align-items:center;overflow:hidden}.scheme-art rb-bear{transform:scale(.83);flex-shrink:0}.scheme-info{padding:20rpx}.scheme-name{font-size:25rpx;font-weight:600;line-height:1.6;overflow-wrap:anywhere}.scheme-date{font-size:19rpx;color:#88715c;margin-top:8rpx}.card-actions{display:flex;gap:28rpx;padding:0 20rpx 16rpx}.card-actions button{margin:0;padding:8rpx 0;background:transparent;font-size:22rpx;line-height:1.5}.selected{border-color:#4d3429;box-shadow:0 0 0 2rpx #4d3429}.selection-box{position:absolute;top:16rpx;left:16rpx;width:42rpx;height:42rpx;background:#fffefa;border:2rpx solid #795540;border-radius:7rpx;text-align:center;line-height:38rpx;font-size:28rpx}.selection-box.checked{background:#4d3429;color:#fffbf2}.management{display:flex;justify-content:space-between;align-items:center;margin-top:24rpx;color:#88715c;font-size:21rpx}.management button{margin:0;padding:14rpx 0;background:transparent;font-size:23rpx;text-decoration:underline}.bulk-actions{position:fixed;bottom:calc(108rpx + env(safe-area-inset-bottom));left:0;right:0;padding:18rpx 38rpx;background:#fffbf2;border-top:1rpx solid #eadbc6;display:flex;align-items:center;justify-content:space-between;font-size:23rpx;z-index:9}.bulk-actions button{margin:0;background:#4d3429;color:#fffbf2;border-radius:20rpx;padding:16rpx 35rpx;font-size:25rpx;line-height:1.5}.design-page.managing{padding-bottom:calc(270rpx + env(safe-area-inset-bottom))}
.bear-thumbnail{width:100%;height:100%;object-fit:contain}

.thumbnail-repair-host{position:fixed;left:-10000px;top:0;width:320px;pointer-events:none}
