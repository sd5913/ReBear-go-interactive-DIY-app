<view class="page model-{{modelId}}">
<view class="step">STEP 2 / 3</view><view class="heading">{{t.heading}}</view>
<rebear-preview id="bear-preview" model-id="{{modelId}}" fabrics="{{previewFabrics}}" assignments="{{assignments}}" language="{{language}}" bind:assign="onAssignFabric"/>
<view class="tabs"><view wx:for="{{parts}}" wx:key="index" class="tab {{part === index ? 'active' : ''}} {{item.invalid ? 'invalid-tab' : ''}}" data-index="{{index}}" bindtap="selectPart">{{item.name}} {{item.invalid ? '!' : (item.done ? '✓' : '')}}</view></view>
<view class="row"><text class="part-title">{{t.parts[part]}} · {{t.piece}}</text><text>{{pieces.length}} / {{slots.length}} {{t.placed}}</text></view><view class="hint">{{t.hint}}</view>
<view class="fabrics"><view wx:for="{{items}}" wx:key="id" class="fabric-tab {{fabricIndex === index ? 'active' : ''}}" data-index="{{index}}" data-id="{{item.id}}" bindtap="selectFabric" bindtouchstart="fabricStart" catchtouchmove="fabricMove" bindtouchend="fabricEnd" bindtouchcancel="fabricCancel"><image class="fabric-chip" src="{{item.image}}" mode="aspectFill"/>{{t.fabric}} {{item.number}}</view></view>
<view wx:if="{{items.length}}" class="hint">{{t.size}} · {{items[fabricIndex].width}} × {{items[fabricIndex].height}} cm</view>
<movable-area wx:if="{{items.length}}" class="cloth"><image class="cloth-image" src="{{items[fabricIndex].image}}" mode="scaleToFill"/>
<view wx:for="{{placedGhosts}}" wx:key="id" hidden="{{item.fabricId !== items[fabricIndex].id}}" class="piece-wrap placed-piece-ghost" style="width:{{item.width * item.scaleX}}rpx;height:{{item.height * item.scaleY}}rpx;transform:translate({{item.x}}px,{{item.y}}px)"><image class="pattern-piece placed-mask" src="{{item.mask}}" mode="aspectFit" style="transform:rotate({{item.angle}}deg)"/><text class="pattern-label">{{t.parts[item.part]}} {{item.label}}</text></view>
<movable-view wx:for="{{pieces}}" wx:key="index" hidden="{{item.fabricId !== items[fabricIndex].id}}" class="piece-wrap current-piece {{selected === index ? 'chosen' : ''}} {{pieceErrors[item.index].invalid ? 'piece-invalid' : ''}}" style="width:{{pieceWidth * item.scaleX}}rpx;height:{{pieceHeight * item.scaleY}}rpx" direction="all" x="{{item.x}}" y="{{item.y}}" data-index="{{index}}" bindchange="move" bindtap="pick"><image class="pattern-piece {{selected === index ? 'mask-selected' : 'mask-idle'}}" src="{{item.mask}}" mode="aspectFit" style="transform:rotate({{item.angle}}deg)"/><text class="pattern-label">{{t.parts[part]}} {{item.label}}</text></movable-view>
</movable-area>
<view class="tray"><view wx:for="{{slots}}" wx:key="index" class="slot {{item.invalid ? 'slot-invalid' : ''}}" data-index="{{index}}" bindtap="addPiece">{{item.label}} {{item.placed ? '✓' : '+'}}<text wx:if="{{item.name}}" class="slot-name">{{item.name}}</text></view></view>
<view class="actions"><button bindtap="rotate">{{t.rotate}}</button><button bindtap="reset">{{t.reset}}</button></view>
<button class="primary" bindtap="confirm" disabled="{{!canConfirm}}">{{t.confirm}}</button>
<button class="primary" bindtap="guide" disabled="{{!allDone}}">{{t.done}}</button><button class="primary" bindtap="openSave" disabled="{{!allDone}}">保存至设计稿</button><button class="plain" bindtap="back">{{t.back}}</button>
<image wx:if="{{drag}}" class="fabric-ghost" mode="aspectFill" src="{{drag.image}}" style="left:{{drag.x}}px;top:{{drag.y}}px"/>
</view>
<view wx:if="{{exitDialog||saveDialog}}" class="confirm-mask"><view class="confirm-card"><view class="confirm-title">{{exitDialog?'您还没有保存，确定退出吗？':'保存至设计稿'}}</view><input wx:if="{{saveDialog}}" placeholder="方案名称" value="{{saveName}}" bindinput="inputSaveName"/><view class="confirm-actions"><button bindtap="exitDialog?cancelExit:cancelSave">再想想</button><button class="primary" bindtap="exitDialog?confirmExit:saveToDesigns">{{exitDialog?'退出':'保存'}}</button></view></view></view>
