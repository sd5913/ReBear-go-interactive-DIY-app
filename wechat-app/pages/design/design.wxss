.page{padding:28rpx 40rpx 48rpx;font-size:25rpx}.step{font-size:23rpx;color:#777}.heading{font-size:40rpx;font-weight:700;margin:20rpx 0}.tabs,.fabrics,.actions{display:flex;gap:10rpx;margin:20rpx 0}.tab,.fabric-tab{flex:1;border:1rpx solid #bbb;border-radius:8rpx;padding:14rpx 6rpx;text-align:center;font-size:23rpx}.active{background:#292929;color:#fff}.fabrics{flex-wrap:wrap}.fabric-tab{flex:0 1 auto;min-width:120rpx;padding:12rpx 18rpx}.row{display:flex;justify-content:space-between;align-items:center;margin-top:24rpx}.part-title{font-weight:700;font-size:28rpx}.hint{font-size:22rpx;color:#666;line-height:1.5;margin:12rpx 0}.cloth{display:block;width:100%;height:350rpx;background:#ddd;overflow:hidden;border:1rpx solid #aaa}.cloth-image{position:absolute;width:100%;height:100%;opacity:.75}.piece-wrap{width:116rpx;height:140rpx;box-sizing:border-box;padding:10rpx}.chosen{outline:3rpx dashed #292929;outline-offset:-3rpx}.piece{width:100%;height:100%;border:3rpx solid #333;border-radius:42%;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.3);font-size:20rpx;box-sizing:border-box}.part-2{border-radius:50% 50% 35% 35%}.tray{display:flex;gap:16rpx;padding:20rpx;background:#f6f6f6;margin-top:16rpx}.slot{padding:20rpx;border:1rpx solid #777;border-radius:18rpx}.actions button{flex:1;width:auto;max-width:none;margin:0;padding:14rpx 8rpx;font-size:23rpx;line-height:1.5;font-weight:400}.page button.primary{width:100%;max-width:none;margin:16rpx 0 0;background:#292929;color:white;border-radius:12rpx;padding:22rpx 12rpx;line-height:1.5;font-weight:400;font-size:26rpx}.page button.primary[disabled]{background:#ccc;color:#fff}.plain{font-size:25rpx;background:transparent;margin-top:20rpx;font-weight:400}

.fabric-tab{display:flex;align-items:center;justify-content:center;gap:8rpx}.fabric-chip{width:36rpx;height:36rpx;border-radius:6rpx}.fabric-ghost{position:fixed;z-index:20;width:88rpx;height:88rpx;border:3rpx solid #fff;border-radius:12rpx;box-shadow:0 4rpx 14rpx #0004;pointer-events:none}.tray{flex-wrap:wrap}.slot-name{display:block;font-size:19rpx}.piece-wrap[hidden]{display:none}
