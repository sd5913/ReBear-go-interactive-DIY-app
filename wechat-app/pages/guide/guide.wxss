.page{padding:30rpx 42rpx 50rpx;font-size:26rpx}.step{font-size:23rpx}.heading{font-weight:700;font-size:40rpx;line-height:1.3;margin:24rpx 0 14rpx}.intro{line-height:1.6;margin-bottom:20rpx}.pattern{width:100%;display:block}.list-title{font-size:28rpx;font-weight:700;margin:18rpx 0}.row{display:flex;justify-content:space-between;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #eee}.assignments{text-align:right;font-size:23rpx;color:#666}.page button{width:100%;max-width:none;padding:22rpx 16rpx;margin:20rpx 0 0;font-size:27rpx;font-weight:400;line-height:1.5;border-radius:14rpx}.secondary{background:#e7e7e7;border:1rpx solid #888}.primary{background:#292929;color:#fff}.plain{background:transparent}.instructions{line-height:1.8;margin-top:18rpx}.note{font-size:22rpx;line-height:1.5;margin-top:16rpx;color:#666}.footer{margin-top:70rpx}
.page{background:repeating-linear-gradient(90deg,#fbf1dc 0 18rpx,#fffbf2 18rpx 50rpx);padding:28rpx 38rpx 50rpx}.heading{font-size:43rpx;font-family:'KaiTi',serif;line-height:1.5}.intro,.note{color:#88715c}.pattern{background:#fffefa;border:3rpx solid #795540;outline:1rpx dashed #c9ae8d;outline-offset:-12rpx;border-radius:30rpx;padding:20rpx;box-sizing:border-box}.list-title{font-size:31rpx}.row{background:#fffbf2;border-bottom:1rpx dashed #c7ac8e;padding:18rpx 14rpx;font-size:25rpx}.assignments{color:#88715c;font-size:21rpx}.secondary{background:#dae9ed;border:none}.primary{background:#4d3429;color:#fffbf2}.page button{border-radius:24rpx}.instructions{background:#fffbf2;padding:18rpx;font-size:24rpx}.sheet .sheet-title{text-align:center}.sheet .sheet-text{text-align:center}
