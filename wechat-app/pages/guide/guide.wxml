<view class="page"><view class="steps"><view class="step-pill ">{{t.stepsLabel[0]}}</view><view class="step-pill ">{{t.stepsLabel[1]}}</view><view class="step-pill current">{{t.stepsLabel[2]}}</view></view><view class="heading">{{t.heading}}</view><view class="intro">{{t.intro}}</view><image class="pattern" src="/assets/pattern-demo.png" mode="widthFix"/><view class="list-title">{{t.list}}</view><view class="row" wx:for="{{rows}}" wx:key="name"><view>{{item.name}} × {{item.count}}</view><view class="assignments"><view wx:for="{{item.assignments}}" wx:for-item="assignment" wx:key="label">{{assignment.label}} → {{t.fabric}} {{assignment.fabric}}</view></view></view><button class="secondary" bindtap="toggle">{{expanded ? t.close : t.open}}</button><view wx:if="{{expanded}}" class="instructions"><view wx:for="{{t.steps}}" wx:key="*this">{{item}}</view></view><view class="note">{{t.note}}</view><view class="footer"><button class="secondary" bindtap="edit">{{t.edit}}</button><button class="primary" bindtap="finish">{{t.finish}}</button><button class="plain" bindtap="home">{{t.home}}</button></view></view>
<view wx:if="{{finished}}" class="sheet-mask" bindtap="closeFinish"><view class="sheet" catchtap="stop"><view class="sheet-handle"></view><view class="sheet-art"><rb-bear/></view><view class="sheet-title">{{t.finishTitle}}</view><view class="sheet-text">{{t.done}}</view><button class="dark" bindtap="closeFinish">{{t.stay}}</button><button bindtap="home">{{t.home}}</button></view></view>
