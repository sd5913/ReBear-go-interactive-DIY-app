.measure-page{padding:24rpx 20px calc(40rpx + env(safe-area-inset-bottom));background:#fffbf2;min-height:100vh;color:#4d3429}.progress{display:flex;gap:10rpx}.chip{flex:1;padding:12rpx 4rpx;text-align:center;border-radius:20rpx;background:#f5eddd;font-size:20rpx;line-height:1.5}.chip.active{background:#f4dfb2;font-weight:600}.heading{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;font-weight:600;font-size:38rpx;line-height:1.4;margin:28rpx 0 18rpx}.intro{font-size:24rpx;color:#88715c;line-height:1.7;margin:16rpx 0 24rpx}.canvas-wrap{overflow:hidden;background:#e8dfd2;border-radius:20rpx}.count{font-size:24rpx;text-align:center;color:#88715c;margin:14rpx 0}.actions{display:flex;gap:18rpx;margin:16rpx 0}.measure-page button{max-width:none;font-size:25rpx;font-weight:400;line-height:1.5;margin:0;padding:19rpx 12rpx;border-radius:20rpx}.actions button{flex:1;width:0;background:#fffefa;border:1rpx solid #c7ac8e}.edge-box{background:#f7f0e4;border-radius:20rpx;padding:20rpx;font-size:24rpx;margin:24rpx 0}.actions button.chosen{background:#f4dfb2;border:2rpx solid #795540}.controls{display:flex;flex-direction:column;gap:20rpx;margin-top:24rpx}.primary{width:100%;background:#4d3429;color:#fffbf2}.secondary{width:100%;background:#f4dfb2;color:#4d3429}.plain{width:100%;background:transparent;color:#88715c;text-decoration:underline}.error{color:#a33121;background:#fff0eb;padding:20rpx;border-radius:16rpx;font-size:25rpx;line-height:1.6;margin:20rpx 0}.loading{text-align:center;padding:20rpx;font-size:25rpx}.demo-note{font-size:21rpx;color:#88715c;line-height:1.7;margin-top:18rpx}.preview-box{background:repeating-conic-gradient(#ede5d7 0% 25%,#fffefa 0% 50%) 0 0 / 24rpx 24rpx;border:1rpx solid #c7ac8e;border-radius:20rpx;overflow:hidden}.preview{display:block;width:100%;height:440rpx}.result-box{background:#f5eddd;padding:24rpx;border-radius:20rpx;margin:24rpx 0;font-size:23rpx;line-height:1.6}.big{font-size:42rpx;font-weight:600;margin:10rpx 0}.result-row{border-top:1rpx dashed #c7ac8e;padding-top:15rpx}.edge-label{margin-top:20rpx;color:#88715c}.process-canvas{position:fixed;left:-10000px;top:0;width:1px;height:1px}

.count{font-size:23rpx;line-height:1.6}.secondary-actions button{background:transparent;color:#88715c;padding:13rpx 8rpx}.canvas-wrap canvas{touch-action:none}
