page { background: #fff; color: #292929; }
.home { min-height: calc(100vh - 88px); padding: 36rpx 46rpx 28rpx; box-sizing: border-box; display: flex; flex-direction: column; }
.top-row { display: flex; justify-content: space-between; align-items: center; }
.brand { font-size: 84rpx; font-weight: 700; line-height: 1.2; }
.language-switch { display: flex; align-items: center; flex-shrink: 0; }
.language-option { margin: 0; padding: 12rpx 8rpx; background: transparent; color: #888; font-size: 24rpx; line-height: 40rpx; border-radius: 0; font-weight: 400; }
.language-option::after { border: none; }
.language-option.selected { color: #292929; font-weight: 700; text-decoration: underline; }
.divider { color: #aaa; font-size: 22rpx; }
.tagline { margin-top: 32rpx; font-size: 29rpx; }
.hero { margin-top: 60rpx; background: #f6f6f6; }
.bear-image { display: block; width: 100%; }
.caption { padding: 6rpx 16rpx 10rpx; font-size: 21rpx; }
.headline { margin-top: 30rpx; font-size: 44rpx; font-weight: 700; line-height: 1.5; white-space: pre-line; }
.headline-en { font-size: 39rpx; line-height: 1.35; }
.description { margin-top: 24rpx; font-size: 27rpx; line-height: 1.5; }
.footer { margin-top: auto; padding-top: 70rpx; padding-bottom: env(safe-area-inset-bottom); }
.home .footer .start-button { display: block; width: 100%; max-width: none; box-sizing: border-box; margin: 0; padding: 0 24rpx; background: #292929; color: #fff; font-size: 28rpx; border-radius: 16rpx; line-height: 92rpx; font-weight: 400; }
.start-button::after { border: none; }
.note { margin-top: 16rpx; font-size: 22rpx; }

.home .language-option{width:auto!important;min-width:56rpx;max-width:none;margin:0;padding:12rpx 8rpx;flex:none;} .language-switch{gap:4rpx;}
