.home{padding-bottom:calc(130rpx + env(safe-area-inset-bottom));min-height:100vh}.top-row{display:flex;align-items:center;justify-content:space-between;padding:26rpx 42rpx;background:#fffbf2}.brand{font-size:48rpx;font-weight:800;letter-spacing:-2rpx}.language-switch{display:flex;align-items:center;gap:8rpx}.home .language-option{margin:0;padding:12rpx 8rpx;background:transparent;width:auto;max-width:none;min-width:60rpx;font-size:24rpx;line-height:1.5;color:#88715c;font-weight:400}.language-option.selected{color:#4d3429;text-decoration:underline;font-weight:700}.surface{padding:38rpx 38rpx 40rpx;background:repeating-linear-gradient(90deg,#fbf1dc 0 18rpx,#fffbf2 18rpx 50rpx)}.headline{font-size:49rpx;font-weight:700;line-height:1.65;white-space:pre-line}.headline-en{font-family:Georgia,serif;font-size:42rpx;line-height:1.4}.tagline{font-size:29rpx;color:#88715c;margin-top:22rpx}.hero{height:390rpx;display:flex;align-items:center;justify-content:center;position:relative}.hero rb-bear{transform:scale(1.2);z-index:1}.halo{position:absolute;width:340rpx;height:250rpx;border-radius:50%;background:#f4dfb2;bottom:50rpx}.hero-badge{position:absolute;right:0;top:40rpx;background:#dae9ed;padding:12rpx 18rpx;border-radius:18rpx;transform:rotate(4deg);font-size:21rpx;z-index:2}.floor-stitch{position:absolute;bottom:10rpx;color:#aa835e;font-size:30rpx}.home button.start-button{max-width:none;width:100%;margin:0;background:#4d3429;color:#fffbf2;border-radius:26rpx;padding:25rpx 18rpx;font-size:27rpx;line-height:1.5;font-weight:400;box-shadow:0 5rpx 0 #dcc8b4}.note{font-size:21rpx;color:#88715c;text-align:center;margin:24rpx 0 36rpx;line-height:1.6}.home-links{display:flex;gap:22rpx}.home-link{flex:1;padding:26rpx 20rpx;min-width:0}.butter{background:#f4dfb2}.blue{background:#dae9ed}.link-icon{font-size:55rpx;line-height:1}.link-title{font-family:'KaiTi',serif;font-size:31rpx;font-weight:700;margin-top:18rpx;line-height:1.4}.link-hint{font-size:19rpx;color:#88715c;line-height:1.6;margin-top:16rpx}.nav{position:fixed;bottom:0;left:0;right:0;background:#fffefa;border-top:1rpx solid #eadbc6;display:flex;padding:14rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));z-index:10}.nav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:8rpx;font-size:21rpx;color:#88715c}.nav-icon{font-size:42rpx;line-height:1.1;width:100rpx;text-align:center;border-radius:24rpx}.nav-item.active .nav-icon{background:#f4dfb2}.nav-item.active{color:#4d3429}
