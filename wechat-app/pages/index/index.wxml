<view class="home"><view class="top-row"><view class="brand">ReBear</view><view class="language-switch"><button class="language-option {{language==='zh'?'selected':''}}" data-language="zh" bindtap="changeLanguage">中文</button><text>/</text><button class="language-option {{language==='en'?'selected':''}}" data-language="en" bindtap="changeLanguage">EN</button></view></view><view class="surface"><view class="headline {{language==='en'?'headline-en':''}}">{{t.headline}}</view><view class="tagline">{{t.tagline}}</view><view class="hero"><view class="hero-badge">{{t.badge}}</view><view class="halo"></view><rb-bear/><view class="floor-stitch">﹏﹏﹏﹏﹏﹏﹏﹏</view></view><button class="start-button" bindtap="startMaking">{{t.start}}</button><view class="note">{{t.note}}</view><view class="home-links"><view class="paper-card home-link butter" bindtap="startMaking"><view class="link-icon">＋</view><view class="link-title">{{t.prepare}}</view><view class="link-hint">{{t.prepareHint}}</view></view><view class="paper-card home-link blue" bindtap="about"><view class="link-icon">♡</view><view class="link-title">{{t.story}}</view><view class="link-hint">{{t.storyHint}}</view></view></view></view><view class="nav"><view class="nav-item active"><text class="nav-icon">⌂</text><text>{{t.home}}</text></view><view class="nav-item" bindtap="startMaking"><text class="nav-icon">✂</text><text>{{t.studio}}</text></view><view class="nav-item" bindtap="guide"><text class="nav-icon">▤</text><text>{{t.guide}}</text></view></view></view>
