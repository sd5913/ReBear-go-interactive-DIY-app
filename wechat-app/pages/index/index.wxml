<view class="home">
  <view class="top-row">
    <view class="brand">ReBear</view>
    <view class="language-switch">
      <button class="language-option {{language === 'zh' ? 'selected' : ''}}" data-language="zh" bindtap="changeLanguage" aria-label="切换为中文">中文</button>
      <text class="divider">/</text>
      <button class="language-option {{language === 'en' ? 'selected' : ''}}" data-language="en" bindtap="changeLanguage" aria-label="Switch to English">EN</button>
    </view>
  </view>
  <view class="tagline">{{t.tagline}}</view>
  <view class="hero">
    <image class="bear-image" src="/assets/bear-home.png" mode="widthFix" />
    <view class="caption">{{t.caption}}</view>
  </view>
  <view class="headline {{language === 'en' ? 'headline-en' : ''}}">{{t.headline}}</view>
  <view class="description">{{t.description}}</view>
  <view class="footer">
    <button class="start-button" bindtap="startMaking">{{t.start}}</button>
    <view class="note">{{t.note}}</view>
  </view>
</view>
