.fabric-page{padding:28rpx 38rpx 210rpx;min-height:100vh;background:repeating-linear-gradient(90deg,#fbf1dc 0 18rpx,#fffbf2 18rpx 50rpx)}.heading{font-size:43rpx;font-weight:700;line-height:1.5;margin:14rpx 0 20rpx}.intro{font-size:24rpx;color:#88715c;line-height:1.7;margin-bottom:38rpx}.empty{padding:50rpx 30rpx;background:#f4dfb2;text-align:center}.empty rb-bear{margin:0 auto 22rpx;transform:scale(.85)}.empty-title{font-size:42rpx;font-weight:700;margin:12rpx 0 24rpx}.empty-hint{font-size:24rpx;color:#88715c;line-height:1.8;max-width:430rpx;margin:auto}.card{display:flex;gap:22rpx;padding:26rpx 22rpx;margin:26rpx 0;position:relative}.thumb{width:130rpx;height:140rpx;border-radius:22rpx;border:1rpx solid #b6987c;flex-shrink:0}.info{flex:1;min-width:0}.card-title{font-family:'KaiTi',serif;font-weight:700;font-size:31rpx;padding-right:70rpx;line-height:1.4}.dimensions{font-size:22rpx;color:#88715c;margin:16rpx 0}.saved-badge{position:absolute;right:24rpx;top:35rpx;background:#dae9ed;color:#88715c;padding:7rpx 10rpx;border-radius:12rpx;font-size:17rpx}.actions{display:flex;gap:14rpx;margin-top:24rpx}.actions button{flex:1;margin:0;max-width:none;width:auto;padding:12rpx 4rpx;font-size:22rpx;border:1rpx solid #c7ac8e;line-height:1.5;border-radius:18rpx;background:#fffbf2;font-weight:400}.fabric-page button.wide{display:block;width:100%;max-width:none;margin:24rpx 0 0;padding:25rpx 16rpx;line-height:1.5;font-size:27rpx;font-weight:400;background:#4d3429;color:#fffbf2;border-radius:26rpx}.fabric-page button.secondary{background:#f4dfb2;color:#4d3429}.fabric-page button.wide[disabled]{background:#bdaf9a;color:#fffbf2}.bottom{position:fixed;bottom:0;left:0;right:0;background:#fffbf2;padding:0 38rpx calc(24rpx + env(safe-area-inset-bottom));border-top:1rpx solid #eadbc6;z-index:5}.sample-button,.plain{background:transparent!important;font-size:23rpx!important;line-height:1.7!important;text-decoration:underline;font-weight:400!important;margin:25rpx auto!important}.library-note{color:#88715c;font-size:23rpx;line-height:1.8;margin:20rpx 3rpx}.photo-area{display:block;width:100%;height:440rpx;background:#e7dece;border:1rpx solid #c7ac8e;border-radius:30rpx;overflow:hidden}.photo{position:absolute;width:100%;height:100%}.selection{border:4rpx dashed #4d3429;box-sizing:border-box;box-shadow:0 0 0 900rpx #4d342944;display:flex;align-items:center;justify-content:center}.selection-label{background:#fffbf2dd;border-radius:12rpx;padding:8rpx;font-size:20rpx}.region-label{font-size:22rpx;color:#88715c;margin-top:15rpx}.fields{display:flex;gap:22rpx;margin:20rpx 0 30rpx}.field{flex:1;min-width:0;font-size:23rpx}.field input{display:block;background:#fffefa;border:1rpx solid #c7ac8e;border-radius:22rpx;height:88rpx;padding:0 20rpx;font-size:29rpx;margin-top:14rpx}.bottom .plain{margin:15rpx auto!important}

.crop-canvas{position:fixed;left:-5000px;top:0;pointer-events:none}