page{background:#fff;color:#292929}.fabric-page{padding:32rpx 46rpx;min-height:calc(100vh - 88px);box-sizing:border-box;display:flex;flex-direction:column;font-size:27rpx}.step{font-weight:700;font-size:24rpx}.heading{font-size:42rpx;font-weight:700;margin:28rpx 0;line-height:1.3}.intro{line-height:1.6;margin-bottom:24rpx}.empty{background:#f6f6f6;padding:64rpx 40rpx;min-height:300rpx;box-sizing:border-box}.plus{font-size:110rpx}.empty-title{font-size:34rpx;font-weight:700;margin:20rpx 0 30rpx}.fabric-page button.wide{display:block;width:100%;max-width:none;margin:24rpx 0 0;padding:22rpx 20rpx;box-sizing:border-box;background:#292929;color:#fff;font-size:27rpx;line-height:1.5;border-radius:16rpx;font-weight:400}.fabric-page button.wide[disabled]{background:#b6b6b6;color:#fff}.bottom{margin-top:auto;padding-top:64rpx;padding-bottom:env(safe-area-inset-bottom)}button::after{border:none}.card{display:flex;background:#f6f6f6;padding:20rpx;margin-bottom:20rpx;gap:20rpx}.thumb{width:130rpx;height:150rpx;flex-shrink:0}.info{flex:1}.card-title{font-weight:700;margin-bottom:12rpx}.actions{display:flex;margin-top:14rpx;gap:16rpx}.actions button{margin:0;padding:8rpx 24rpx;font-size:24rpx;line-height:1.5;font-weight:400;background:#e5e5e5}.photo-area{display:block;width:100%;height:440rpx;background:#eee}.photo{position:absolute;width:100%;height:100%}.selection{border:4rpx dashed #292929;box-sizing:border-box;background:rgba(255,255,255,.1)}.region-label{margin-top:20rpx;font-size:24rpx}.fabric-page button.plain{background:transparent;font-weight:400;font-size:26rpx;margin:16rpx 0;padding:12rpx;line-height:1.5;max-width:none;width:100%}.field{display:flex;align-items:center;justify-content:space-between;margin:16rpx 0;gap:20rpx}.field input{width:45%;background:#eee;border:1rpx solid #888;border-radius:14rpx;text-align:center;height:80rpx;flex-shrink:0}
