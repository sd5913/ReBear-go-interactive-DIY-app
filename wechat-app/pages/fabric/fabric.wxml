<view class="fabric-page">
  <block wx:if="{{!editing}}">
    <view class="heading">{{t.heading}}</view>
    <view class="intro">{{t.intro}}</view>
    <view wx:if="{{!items.length}}" class="empty paper-card">
      <rb-bear />
      <view class="empty-title">{{t.empty}}</view>
      <view class="empty-hint">{{t.emptyHint}}</view>
    </view>
    <view wx:for="{{items}}" wx:key="id" class="card paper-card">
      <image src="{{item.image}}" class="thumb" mode="aspectFill" />
      <view class="info">
        <view class="card-title">{{t.fabric}} {{index+1}} {{item.name ? ' · '+item.name : ''}}</view>
        <view class="dimensions">{{item.width}} × {{item.height}} cm · {{item.measurement?t.a4:t.sizeHint}}</view>
        <view class="actions"><button data-id="{{item.id}}" bindtap="remove">{{t.remove}}</button></view>
      </view><text class="saved-badge">{{t.saved}}</text>
    </view><button class="wide {{items.length?'secondary':''}}" bindtap="add">{{t.add}}</button><button wx:if="{{!items.length}}" class="sample-button" bindtap="sample">{{t.sample}}</button>
    <view class="library-note">{{t.libraryNote}}</view>
    <view class="bottom"><button class="wide" disabled="{{!items.length}}" bindtap="preview">{{items.length?t.preview:t.disabled}}</button></view>
  </block>
  <block wx:else>
    <view class="heading">{{t.mark}}</view>
    <view class="intro">{{t.hint}}</view>
    <movable-area class="photo-area">
      <image src="{{image}}" mode="scaleToFill" class="photo" />
      <movable-view class="selection" direction="all" x="{{x}}" y="{{y}}" style="width:{{selectionSize}}%;height:{{selectionSize}}%" bindchange="move" out-of-bounds="{{false}}"><text class="selection-label">{{t.sizeHint}}</text></movable-view>
    </movable-area>
    <view class="region-label">{{t.region}}</view>
    <slider min="20" max="100" value="{{selectionSize}}" bindchange="resize" activeColor="#88715c" /><button class="plain" bindtap="choosePhoto">{{t.replace}}</button>
    <view class="fields">
      <view class="field"><text>{{t.width}}</text><input type="digit" value="{{width}}" data-field="width" bindinput="input" placeholder="38" /></view>
      <view class="field"><text>{{t.height}}</text><input type="digit" value="{{height}}" data-field="height" bindinput="input" placeholder="42" /></view>
    </view>
    <view class="soft-note">{{t.measure}}</view>
    <view class="bottom"><button class="wide" bindtap="save">{{t.save}}</button><button class="plain" bindtap="cancel">{{t.cancel}}</button></view>
  </block>
</view>
<view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet">
  <view class="sheet" catchtap="stop">
    <view class="sheet-handle"></view>
    <block wx:if="{{sheet==='photo'}}">
      <view class="sheet-title">{{t.photoTitle}}</view>
      <view class="sheet-text">{{t.photoHint}}</view><button class="dark" data-source="camera" bindtap="choosePhoto">{{t.camera}}</button><button data-source="album" bindtap="choosePhoto">{{t.album}}</button><button data-mode="manual" bindtap="choosePhoto">{{t.manual}}</button><button bindtap="sample">{{t.sample}}</button><button bindtap="closeSheet">{{t.cancelSheet}}</button>
    </block>
    <block wx:else>
      <view class="sheet-title">{{t.deleteTitle}}</view>
      <view class="sheet-text">{{t.deleteHint}}</view><button class="dark" bindtap="deleteConfirmed">{{t.confirm}}</button><button bindtap="closeSheet">{{t.keep}}</button>
    </block>
  </view>
</view>

<canvas canvas-id="cropCanvas" class="crop-canvas" style="width:{{canvasWidth || 1000}}px;height:{{canvasHeight || 1000}}px" />
<upload-guide visible="{{guideVisible}}" language="{{guideLanguage}}" bind:complete="onUploadGuideComplete" bind:skip="onUploadGuideSkip"/>
