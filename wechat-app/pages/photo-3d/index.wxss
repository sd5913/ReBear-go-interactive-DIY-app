page{background:#fffbf2;color:#4d3429}
.preview-page{padding:24rpx 28rpx 48rpx;background:repeating-linear-gradient(90deg,#fbf1dc 0 18rpx,#fffbf2 18rpx 50rpx)}
.switch,.stages,.action-pair{display:flex;gap:10rpx}
.switch{padding:6rpx;margin:0 0 18rpx;background:#ebdfcb;border-radius:22rpx}
.switch-button,.stage-button,.compact{flex:1;min-width:0;width:auto;max-width:none;margin:0;padding:15rpx 6rpx;border:0;border-radius:16rpx;line-height:1.35;font-size:24rpx;color:#4d3429;background:transparent;font-weight:500}
.switch-button::after,.stage-button::after,.compact::after{border:0}
.switch-button.current{background:#fffefa;font-weight:700;box-shadow:0 2rpx 6rpx #4d342918}
.preview-card,.material-card{border:1rpx solid #d9c4a9;border-radius:26rpx;background:#fffefa;overflow:hidden}
.stages{padding:14rpx 16rpx 0}
.stage-button{color:#775d49;background:#f8f1e5}
.stage-button.current{color:#fffefa;background:#4d3429;font-weight:700}
.bear-photo{display:block;width:100%;height:590rpx;margin:4rpx auto}
.preview-caption,.note{font-size:23rpx;line-height:1.55;color:#735b49}
.preview-caption{padding:2rpx 22rpx 19rpx;text-align:center}
.note{margin:18rpx 4rpx}
.empty-preview{min-height:280rpx;display:flex;align-items:center;justify-content:center;padding:30rpx;text-align:center;color:#735b49;font-size:26rpx}
.model-frame{position:relative;margin:0 auto}
.model-viewer{display:block;width:100%;height:100%}
.model-message{position:absolute;z-index:1;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14rpx;padding:36rpx;text-align:center;color:#735b49;background:#fffefa;font-size:25rpx}
.model-message .compact{flex:0 0 auto;padding:12rpx 26rpx}
.section-title{font-size:30rpx;font-weight:700;margin:24rpx 2rpx 12rpx}
.material-row{display:flex;align-items:flex-start;gap:12rpx;padding:13rpx 19rpx;border-bottom:1rpx solid #efdfc8}
.material-row:last-child{border-bottom:0}
.material-part{flex:0 0 104rpx;font-weight:650;line-height:46rpx;font-size:25rpx}
.materials{display:flex;flex:1;gap:10rpx 18rpx;flex-wrap:wrap;min-width:0}
.material{display:flex;align-items:center;flex-wrap:wrap;gap:9rpx;font-size:23rpx;line-height:1.4}
.swatch{width:50rpx;height:42rpx;border:1rpx solid #d9c4a9;border-radius:8rpx;flex:none}
.muted{color:#806e60;font-size:22rpx;line-height:46rpx}
.piece-labels{display:flex;gap:4rpx;color:#806e60;font-size:21rpx}
.action-pair{margin-top:10rpx}
.compact{background:#f6ead5;padding:17rpx 8rpx;font-weight:650}
.compact.accent{background:#4d3429;color:#fffefa}
.compact[disabled]{background:#eee6db;color:#8e7d6e}
.export-canvas{position:fixed;left:-10000px;top:0;width:400px;height:400px;pointer-events:none}
