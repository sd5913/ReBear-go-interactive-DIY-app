page{color:#4d3429;background:#fffbf2;font-family:'Microsoft YaHei',sans-serif;font-size:26rpx}view,button{box-sizing:border-box}button::after{border:0}button{color:#4d3429}button[disabled]{opacity:.55}.heading,.headline,.empty-title,.list-title,.part-title{font-family:'KaiTi','STKaiti',serif}.steps{display:flex;gap:12rpx;margin:0 0 30rpx}.step-pill{flex:1;text-align:center;padding:14rpx 4rpx;border-radius:24rpx;font-size:20rpx;background:#fffbf2;color:#88715c;line-height:1.5}.step-pill.current{background:#f4dfb2;color:#4d3429}.soft-note{padding:22rpx;background:#dae9ed;color:#88715c;border-radius:24rpx;font-size:23rpx;line-height:1.7}.sheet-mask{position:fixed;inset:0;background:rgba(64,39,28,.35);z-index:50;display:flex;align-items:flex-end}.sheet{width:100%;background:#fffbf2;border-radius:46rpx 46rpx 0 0;padding:22rpx 40rpx calc(30rpx + env(safe-area-inset-bottom))}.sheet-handle{width:70rpx;height:7rpx;background:#c7b093;border-radius:8rpx;margin:0 auto 30rpx}.sheet-title{font-family:'KaiTi',serif;font-size:42rpx;font-weight:700;margin:20rpx 0}.sheet-text{font-size:25rpx;line-height:1.8;color:#88715c}.sheet button{max-width:none;width:100%;padding:24rpx 12rpx;margin:20rpx 0 0;border-radius:24rpx;font-size:27rpx;line-height:1.5;font-weight:400;background:#f4dfb2}.sheet button.dark{background:#4d3429;color:#fffbf2}.sheet-art{display:flex;justify-content:center;margin:10rpx 0}.paper-card{border:3rpx solid #795540;border-radius:38rpx 30rpx 36rpx 28rpx;background:#fffefa;outline:1rpx dashed #c9ae8d;outline-offset:-12rpx}
