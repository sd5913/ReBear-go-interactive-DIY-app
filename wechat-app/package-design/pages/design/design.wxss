.page {
  box-sizing: border-box;
  padding: 0 40rpx 48rpx;
  font-size: 25rpx;
}

.interaction-hint {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 116rpx;
  margin: 8rpx 0 0;
  padding: 4rpx 8rpx 8rpx 0;
}

.guide-bubble {
  position: relative;
  box-sizing: border-box;
  display: flex;
  min-height: 76rpx;
  flex: 1;
  align-items: center;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e7c99f;
  border-radius: 24rpx;
  background: #fff7e7;
  box-shadow: 0 4rpx 12rpx rgba(105, 72, 45, .08);
  color: #654637;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.4;
}

.guide-bubble-tail {
  position: absolute;
  top: 50%;
  right: -9rpx;
  box-sizing: border-box;
  width: 18rpx;
  height: 18rpx;
  transform: translateY(-50%) rotate(45deg);
  border-top: 2rpx solid #e7c99f;
  border-right: 2rpx solid #e7c99f;
  background: #fff7e7;
}

.guide-bear-face {
  position: relative;
  box-sizing: border-box;
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  border: 2rpx solid #e7c99f;
  border-radius: 50%;
  background: #f8e7c1;
  box-shadow: 0 4rpx 12rpx rgba(105, 72, 45, .12);
}

.guide-bear-image {
  position: absolute;
  top: 0;
  left: -42rpx;
  width: 210rpx;
  height: 177rpx;
}

.guide-sparkle {
  position: absolute;
  top: 3rpx;
  right: 6rpx;
  color: #e8a94d;
  font-size: 23rpx;
  text-shadow: 0 1rpx 2rpx #fff;
}

.preview-sticky {
  position: relative;
  margin: 0 -16rpx;
  padding: 0;
  background: #fffbf2;
}

.fabrics {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 14rpx 0;
}

.fabric-tab {
  box-sizing: border-box;
  display: flex;
  flex: 0 1 auto;
  min-width: 120rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid #bbb;
  border-radius: 8rpx;
  text-align: center;
  font-size: 23rpx;
}

.fabric-tab.active {
  background: #292929;
  color: #fff;
}

.fabric-chip {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
}

.hint {
  margin: 12rpx 0;
  color: #666;
  font-size: 22rpx;
  line-height: 1.5;
}

.placement-row {
  display: flex;
  width: 100%;
  align-items: flex-start;
  gap: 3%;
  overflow: visible;
}

.workbench-column {
  flex: 0 0 70%;
  width: 70%;
  min-width: 0;
}

.cloth {
  position: relative;
  box-sizing: content-box;
  display: block;
  max-width: 100%;
  margin: 0;
  overflow: hidden;
  background: #ddd;
  outline: 1rpx solid #aaa;
}

.cloth-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: .75;
}

.seam-canvas {
  position: absolute;
  z-index: 1;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.piece-wrap {
  position: absolute;
  top: 0;
  left: 0;
  box-sizing: border-box;
  padding: 0;
  touch-action: none;
}

.placed-piece-ghost {
  z-index: 2;
  opacity: .65;
  pointer-events: auto;
}

.current-piece {
  z-index: 3;
  border: 0;
  background: transparent;
}

.pattern-piece {
  position: absolute;
  inset: 10rpx;
  width: calc(100% - 20rpx);
  height: calc(100% - 20rpx);
  opacity: 1;
  mix-blend-mode: normal;
  pointer-events: none;
}

.mask-idle {
  filter: brightness(0) saturate(100%) invert(51%) sepia(73%) saturate(409%) hue-rotate(82deg) brightness(92%) contrast(90%);
  opacity: .62;
}

.mask-selected,
.placed-mask {
  filter: brightness(0) saturate(100%) invert(16%) sepia(5%) saturate(305%) hue-rotate(169deg) brightness(94%) contrast(90%);
  opacity: .9;
}

.pattern-label {
  position: absolute;
  top: 45%;
  right: 0;
  left: 0;
  color: #fff;
  text-align: center;
  font-size: 18rpx;
  text-shadow: 0 1rpx 2rpx #263238;
}

.piece {
  position: absolute;
  inset: 10rpx;
  box-sizing: border-box;
  display: flex;
  width: calc(100% - 20rpx);
  height: calc(100% - 20rpx);
  align-items: center;
  justify-content: center;
  border: 3rpx solid #333;
  border-radius: 42%;
  background: rgba(255, 255, 255, .3);
  font-size: 20rpx;
}

.model-cushion .part-0,
.model-cushion .part-1 {
  border-radius: 50%;
}

.model-cushion .part-2 {
  border-radius: 0;
}

.piece-invalid .pattern-piece {
  filter: sepia(1) saturate(10) hue-rotate(310deg) !important;
  opacity: .9;
}

.piece-invalid .piece {
  border-color: #c7352b;
  color: #a5231b;
  background: rgba(216, 55, 43, .16);
}

.side-tray {
  display: flex;
  flex: 0 0 27%;
  width: 27%;
  flex-direction: column;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 16rpx;
  margin: 0;
  padding: 0;
  background: transparent;
}

.slot {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 96rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 4rpx;
  border: 1rpx solid #777;
  border-radius: 18rpx;
  text-align: center;
}

.slot.slot-invalid {
  border-color: #c7352b;
  color: #b72c22;
  background: #fff0ed;
}

.slot-name {
  display: block;
  font-size: 19rpx;
}

.fabric-ghost {
  position: fixed;
  z-index: 20;
  width: 88rpx;
  height: 88rpx;
  border: 3rpx solid #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 14rpx #0004;
  pointer-events: none;
}

.piece-wrap[hidden] {
  display: none;
}

.confirm-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(45, 31, 24, .48);
}

.confirm-card {
  box-sizing: border-box;
  width: 100%;
  max-width: 620rpx;
  padding: 38rpx;
  border: 1rpx solid #c7ac8e;
  border-radius: 28rpx;
  background: #fffbf2;
}

.confirm-title {
  margin-bottom: 22rpx;
  color: #4d3429;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
}

.confirm-card input {
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid #c7ac8e;
  border-radius: 14rpx;
  background: #fffefa;
  color: #4d3429;
  font-size: 26rpx;
}

.confirm-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.confirm-actions button {
  box-sizing: border-box;
  flex: 1;
  width: auto;
  max-width: none;
  margin: 0;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.confirm-card .confirm-actions button.primary {
  width: auto;
  margin: 0;
  background: #4d3429;
  color: #fffbf2;
}
