<view class="page model-{{modelId}}">
<view class="step">STEP 2 / 3</view><view class="heading">{{t.heading}}</view>
<view class="preview-sticky"><rebear-preview id="bear-preview" immersive="{{true}}" model-id="{{modelId}}" fabrics="{{previewFabrics}}" assignments="{{assignments}}" language="{{language}}" bind:assign="onAssignFabric"/></view>
<view class="tabs"><view wx:for="{{parts}}" wx:key="index" class="tab {{part === index ? 'active' : ''}} {{item.invalid ? 'invalid-tab' : ''}}" data-index="{{index}}" bindtap="selectPart">{{item.name}} {{item.invalid ? '!' : (item.done ? '✓' : '')}}</view></view>
<view class="row"><text class="part-title">{{t.parts[part]}} · {{t.piece}}</text><text>{{pieces.length}} / {{slots.length}} {{t.placed}}</text></view><view class="hint">{{t.hint}}</view>
<view class="current-issue">{{currentIssue}}</view>
<view class="fabrics"><view wx:for="{{items}}" wx:key="id" class="fabric-tab {{fabricIndex === index ? 'active' : ''}}" data-index="{{index}}" data-id="{{item.id}}" bindtap="selectFabric" bindtouchstart="fabricStart" catchtouchmove="fabricMove" bindtouchend="fabricEnd" bindtouchcancel="fabricCancel"><image class="fabric-chip" src="{{item.image}}" mode="aspectFill"/>{{t.fabric}} {{item.number}}</view></view>
<view wx:if="{{items.length}}" class="hint">{{t.size}} · {{items[fabricIndex].width}} × {{items[fabricIndex].height}} cm</view>
<view wx:if="{{items.length}}" class="cloth" style="width:{{clothWidth}}rpx;height:{{clothHeight}}rpx"><image class="cloth-image" src="{{items[fabricIndex].image}}" mode="scaleToFill"/>
<view wx:for="{{placedGhosts}}" wx:key="id" hidden="{{item.fabricId !== items[fabricIndex].id}}" class="piece-wrap placed-piece-ghost {{item.invalid ? 'piece-invalid' : ''}}" data-part="{{item.part}}" data-slot="{{item.index}}" bindtap="selectGhost" style="width:{{item.width * item.scaleX * item.sizeScale}}rpx;height:{{item.height * item.scaleY * item.sizeScale}}rpx;transform:translate({{item.x}}px,{{item.y}}px)"><image wx:if="{{item.mask}}" class="pattern-piece placed-mask" src="{{item.mask}}" mode="aspectFit" style="left:{{10 * item.scaleX * item.sizeScale}}rpx;right:auto;top:{{10 * item.scaleY * item.sizeScale}}rpx;bottom:auto;width:{{item.width * item.scaleX * item.sizeScale - 20 * item.scaleX * item.sizeScale}}rpx;height:{{item.height * item.scaleY * item.sizeScale - 20 * item.scaleY * item.sizeScale}}rpx;transform:rotate({{item.angle}}deg)"/><view wx:if="{{!item.mask}}" class="piece part-{{item.part}}" style="inset:auto;left:{{10 * item.sizeScale}}rpx;top:{{10 * item.sizeScale}}rpx;width:{{(item.width - 20) * item.sizeScale}}rpx;height:{{(item.height - 20) * item.sizeScale}}rpx;transform:rotate({{item.angle}}deg)"></view><text class="pattern-label">{{t.parts[item.part]}} {{item.label}} {{item.status}}</text></view>
<view wx:for="{{pieces}}" wx:key="index" hidden="{{item.fabricId !== items[fabricIndex].id}}" class="piece-wrap current-piece {{selected === index ? 'chosen' : ''}} {{pieceErrors[item.index].invalid ? 'piece-invalid' : ''}}" style="width:{{pieceWidth * item.scaleX * item.sizeScale}}rpx;height:{{pieceHeight * item.scaleY * item.sizeScale}}rpx;left:{{item.x}}px;top:{{item.y}}px"  data-index="{{index}}" bindtap="pick" bindtouchstart="pieceTouchStart" catchtouchmove="pieceTouchMove" bindtouchend="pieceTouchEnd" bindtouchcancel="pieceTouchEnd"><image wx:if="{{item.mask}}" class="pattern-piece {{selected === index ? 'mask-selected' : 'mask-idle'}}" src="{{item.mask}}" mode="aspectFit" style="left:{{10 * item.scaleX * item.sizeScale}}rpx;right:auto;top:{{10 * item.scaleY * item.sizeScale}}rpx;bottom:auto;width:{{pieceWidth * item.scaleX * item.sizeScale - 20 * item.scaleX * item.sizeScale}}rpx;height:{{pieceHeight * item.scaleY * item.sizeScale - 20 * item.scaleY * item.sizeScale}}rpx;transform:rotate({{item.angle}}deg)"/><view wx:if="{{!item.mask}}" class="piece part-{{part}}" style="inset:auto;left:{{10 * item.sizeScale}}rpx;top:{{10 * item.sizeScale}}rpx;width:{{(pieceWidth - 20) * item.sizeScale}}rpx;height:{{(pieceHeight - 20) * item.sizeScale}}rpx;transform:rotate({{item.angle}}deg)"></view><text class="pattern-label">{{t.parts[part]}} {{item.label}}</text></view>
</view>
<view class="tray"><view wx:for="{{slots}}" wx:key="index" class="slot {{item.invalid ? 'slot-invalid' : ''}}" data-index="{{index}}" bindtap="addPiece">{{item.label}} {{item.placed ? '✓' : '+'}}<text wx:if="{{item.name}}" class="slot-name">{{item.name}}</text></view></view>
<view class="actions"><button bindtap="rotate">{{t.rotate}}</button><button bindtap="reset">{{t.reset}}</button></view>
<button class="primary" bindtap="confirm" disabled="{{!canConfirm}}">{{t.confirm}}</button>
<button class="primary" bindtap="guide" disabled="{{!allDone}}">{{t.done}}</button><view class="completion-status" bindtap="explainIncomplete">{{language === 'en' ? 'Confirmed ' : '已确认 '}}{{confirmedCount}} / {{partCount}} {{language === 'en' ? 'parts' : '个部位'}}{{allDone ? (language === 'en' ? ' · Ready to save' : ' · 可以保存') : (language === 'en' ? ' · Tap to locate remaining items' : ' · 点击定位待处理项')}}</view><button class="primary" disabled="{{!allDone}}" bindtap="openSave">保存至设计稿</button><button class="plain" bindtap="back">{{t.back}}</button>
<image wx:if="{{drag}}" class="fabric-ghost" mode="aspectFill" src="{{drag.image}}" style="left:{{drag.x}}px;top:{{drag.y}}px"/>
</view>
<view wx:if="{{exitDialog||saveDialog}}" class="confirm-mask"><view class="confirm-card" catchtap="stopDialog"><view class="confirm-title">{{exitDialog?'您还没有保存，确定退出吗？':'保存至设计稿'}}</view><input wx:if="{{saveDialog}}" placeholder="方案名称" value="{{saveName}}" maxlength="40" bindinput="inputSaveName"/><view class="confirm-actions"><button bindtap="cancelDialog">再想想</button><button class="primary" bindtap="confirmDialog">{{exitDialog?'退出':'保存'}}</button></view></view></view>
