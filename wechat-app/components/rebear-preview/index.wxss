.preview{padding:10rpx;background:#fdf9f1;border:1rpx solid #d6bd9e;border-radius:18rpx;overflow:hidden}
.canvas{display:block;width:100%;height:420rpx}
.canvas-hidden{display:none}
.views{display:flex;justify-content:center;gap:12rpx;margin-top:8rpx}
.views .view-button{margin:0;color:#583f33;background:#fffaf0;border-radius:100rpx;font-size:22rpx}
.hint{padding:10rpx 14rpx;text-align:center;color:#78624e;font-size:22rpx}
.preview.immersive{padding:0;background:transparent;border:0;border-radius:0}
.preview.immersive{position:relative}
.canvas.immersive-canvas{height:620rpx;background:transparent}
.model-actions{position:absolute;left:8rpx;right:8rpx;bottom:18rpx;display:flex;justify-content:space-between;align-items:flex-end;pointer-events:none}
.model-action{pointer-events:auto;box-sizing:border-box;width:150rpx;height:96rpx;padding:10rpx 4rpx;border:1rpx solid #d5a362;border-radius:18rpx;background:rgba(255,251,242,.94);color:#4d3429;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.2;font-size:21rpx;text-align:center;box-shadow:0 0 18rpx rgba(255,165,50,.52)}
.save-action{background:rgba(77,52,41,.94);color:#fffbf2}
.model-action.disabled{opacity:.52;box-shadow:none}
.model-action-icon{font-size:29rpx;line-height:1.1}

.celebration{position:absolute;z-index:5;width:1px;height:1px;pointer-events:none}.success-check{position:absolute;left:-25rpx;top:-25rpx;width:50rpx;height:50rpx;border-radius:50%;background:#f5fff5;color:#27a653;border:3rpx solid #27a653;text-align:center;line-height:48rpx;font-size:34rpx;font-weight:700;animation:check-pop .9s ease-out both;box-shadow:0 0 18rpx rgba(45,190,95,.45)}.spark{position:absolute;left:-7rpx;top:-9rpx;color:#4dc878;font-size:28rpx;animation-duration:.78s;animation-timing-function:ease-out;animation-fill-mode:both}.spark-a{animation-name:spark-a-out}.spark-b{color:#a8d94b;animation-name:spark-b-out}.spark-c{color:#42bf9c;animation-name:spark-c-out}.spark-d{color:#8bd63f;animation-name:spark-d-out}.spark-e,.spark-f{font-size:36rpx}.spark-e{animation-name:spark-e-out}.spark-f{animation-name:spark-f-out}@keyframes check-pop{0%{transform:scale(.25);opacity:0}18%{transform:scale(1.2);opacity:1}70%{transform:scale(1);opacity:1}100%{transform:scale(.72);opacity:0}}@keyframes spark-a-out{0%{transform:translate(0,0) scale(.3);opacity:0}16%{opacity:1}100%{transform:translate(-42rpx,-36rpx) scale(1.1);opacity:0}}@keyframes spark-b-out{0%{transform:translate(0,0) scale(.3);opacity:0}16%{opacity:1}100%{transform:translate(40rpx,-40rpx) scale(1.1);opacity:0}}@keyframes spark-c-out{0%{transform:translate(0,0) scale(.3);opacity:0}16%{opacity:1}100%{transform:translate(52rpx,6rpx) scale(1.1);opacity:0}}@keyframes spark-d-out{0%{transform:translate(0,0) scale(.3);opacity:0}16%{opacity:1}100%{transform:translate(-48rpx,12rpx) scale(1.1);opacity:0}}@keyframes spark-e-out{0%{transform:translate(0,0) scale(.3);opacity:0}16%{opacity:1}100%{transform:translate(8rpx,-54rpx) scale(1.1);opacity:0}}@keyframes spark-f-out{0%{transform:translate(0,0) scale(.3);opacity:0}16%{opacity:1}100%{transform:translate(-8rpx,48rpx) scale(1.1);opacity:0}}