.preview{padding:10rpx;background:#fdf9f1;border:1rpx solid #d6bd9e;border-radius:18rpx;overflow:hidden}
.canvas{display:block;width:100%;height:420rpx}
.canvas[hidden]{display:none}
.views{display:flex;justify-content:center;gap:12rpx;margin-top:8rpx}
.views button{margin:0;color:#583f33;background:#fffaf0;border-radius:100rpx;font-size:22rpx}
.hint{padding:10rpx 14rpx;text-align:center;color:#78624e;font-size:22rpx}
