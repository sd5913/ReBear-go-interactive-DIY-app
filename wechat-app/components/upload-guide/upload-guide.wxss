:host{display:block}.guide-mask{position:fixed;inset:0;z-index:1000;background:rgba(53,38,28,.5);display:flex;align-items:center;justify-content:center;padding:28rpx;box-sizing:border-box}.guide-dialog{width:100%;max-width:680rpx;max-height:92vh;background:#fffbf2;border:3rpx solid #795540;border-radius:36rpx;box-shadow:0 18rpx 70rpx rgba(50,32,20,.2);overflow:hidden;color:#4d3429;animation:guide-pop .25s ease-out}.guide-header{display:flex;align-items:center;gap:14rpx;padding:22rpx 26rpx 16rpx;border-bottom:1rpx solid #eadbc6}.guide-brand{font-size:30rpx;font-weight:700;flex-shrink:0}.guide-counter{font-size:21rpx;color:#88715c;flex:1;line-height:1.4}.guide-close{width:56rpx;height:56rpx;max-width:none;flex-shrink:0;margin:0;padding:0;line-height:50rpx;font-size:43rpx;font-weight:400;background:#f4ecdd;color:#88715c;border-radius:50%}.guide-close::after,.guide-primary::after,.guide-link::after{border:none}.guide-scroll{height:54vh;max-height:850rpx}.welcome{padding:22rpx 28rpx}.welcome-bear{display:block;width:100%;height:330rpx;animation:bear-hello 2.8s ease-in-out infinite}.speech-bubble{position:relative;padding:30rpx 26rpx;border:2rpx solid #c7ac8e;border-radius:26rpx;background:#f4dfb2;font-size:32rpx;font-weight:500;line-height:1.7;text-align:center}.welcome-dots,.guide-dots{display:flex;justify-content:center;gap:14rpx;margin:28rpx 0 4rpx}.welcome-dot,.guide-dot{width:12rpx;height:12rpx;border-radius:50%;background:#d9c9b1}.guide-dot.current{width:32rpx;border-radius:8rpx;background:#795540}.guide-step{padding:24rpx 26rpx 20rpx}.guide-title{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;font-size:35rpx;font-weight:600;line-height:1.4}.guide-body{font-size:28rpx;line-height:1.7;margin:18rpx 0 22rpx}.guide-illustration{border:1rpx solid #dfccb1;border-radius:24rpx;background:#f4ecdb;overflow:hidden}.guide-image{display:block;width:100%;height:340rpx}.guide-hint{font-size:23rpx;color:#88715c;background:#dae9ed;padding:20rpx;border-radius:18rpx;line-height:1.7;margin-top:20rpx}.guide-footer{padding:20rpx 26rpx 16rpx;border-top:1rpx solid #eadbc6}.guide-primary{width:100%;max-width:none;margin:0;padding:23rpx 12rpx;background:#4d3429;color:#fffbf2;border-radius:22rpx;font-size:28rpx;font-weight:400;line-height:1.5}.guide-links{display:flex;justify-content:center;gap:32rpx;margin-top:10rpx}.guide-link{margin:0;padding:14rpx 10rpx;width:auto;max-width:none;background:transparent;color:#88715c;font-size:23rpx;line-height:1.5;font-weight:400}.guide-link::after{border:0}@keyframes guide-pop{from{opacity:0;transform:translateY(20rpx) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}@keyframes bear-hello{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-8rpx) rotate(2deg)}}

.guide-scroll.welcome-scroll{height:44vh;max-height:700rpx}
