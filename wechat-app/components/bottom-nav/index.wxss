.nav{position:fixed;bottom:0;left:0;right:0;background:#fffefa;border-top:1rpx solid #eadbc6;display:flex;padding:14rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));z-index:10}.nav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:8rpx;font-size:21rpx;color:#88715c}.nav-icon{font-size:42rpx;line-height:1.1;width:100rpx;text-align:center;border-radius:24rpx}.nav-item.active .nav-icon{background:#f4dfb2}.nav-item.active{color:#4d3429}
